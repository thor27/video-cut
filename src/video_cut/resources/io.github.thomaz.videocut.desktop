[Desktop Entry]
Name=Video Cut
Comment=Simple, fast, and modern video cutting and segment arranging tool
Exec=video-cut %U
Icon=io.github.thomaz.videocut
Terminal=false
Type=Application
Categories=AudioVideo;Video;AudioVideoEditing;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;image/jpeg;image/png;
StartupNotify=true
StartupWMClass=io.github.thomaz.videocut
