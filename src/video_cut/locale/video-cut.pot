#: src/video_cut/keyframe_help_dialog.py:19
msgid "Keyframes & Lossless Cutting"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:55
msgid "What is Lossless Cutting?"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:58
#, python-format
msgid ""
"Lossless cutting (stream copying) trims and combines videos by copying the "
"original compressed data packets directly into the new file without decoding "
"or re-encoding. Because no re-compression takes place, exports are virtually "
"instantaneous and preserve 100% of the original video and audio quality."
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:68
msgid "What is a Keyframe?"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:71
msgid ""
"Modern video formats (such as H.264, HEVC, VP9, and AV1) compress video by "
"storing full images only occasionally (Keyframes or I-frames), while "
"intermediate frames only record differences between frames. A keyframe is a "
"complete, standalone picture that can be decoded independently."
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:86
msgid "Advantages of Lossless Cutting"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:90
msgid "Blazing Fast Speed"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:92
msgid ""
"Exports complete in seconds because video and audio packets are copied "
"directly without re-encoding."
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:99
msgid "100% Quality Preserved"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:101
msgid ""
"Zero generation loss or compression artifacts. Every pixel and audio sample "
"remains untouched."
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:108
msgid "Minimal CPU and Battery Usage"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:110
msgid ""
"Bypasses intensive CPU/GPU rendering, keeping your computer cool and "
"preserving laptop battery."
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:118
msgid "Disadvantages of Lossless Cutting"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:122
msgid "Cuts Must Align to Keyframes"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:125
msgid ""
"Intermediate frames depend on surrounding images and cannot be split mid-"
"stream without re-encoding. All cuts snap to the nearest keyframe."
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:134
msgid "No Re-encoding Filters"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:137
msgid ""
"Transformations that alter pixels—such as rotation, cropping, flipping, and "
"text or graphic overlays—require re-encoding and cannot be applied."
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:146
msgid "Matching Codecs Required"
msgstr ""

#: src/video_cut/keyframe_help_dialog.py:149
msgid ""
"When combining multiple clips, all segments must share compatible video and "
"audio formats, codecs, and dimensions."
msgstr ""

