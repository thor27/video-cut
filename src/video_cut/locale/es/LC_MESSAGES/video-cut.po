msgid "Video Cut"
msgstr "Video Cut"

msgid "Video Editor"
msgstr "Editor de Vídeo"

msgid "About Video Cut"
msgstr "Acerca de Video Cut"

msgid "A simple, fast, and modern video cutting and segment arranging tool"
msgstr "Una herramienta simple, rápida y moderna para cortar y organizar segmentos de vídeo"

msgid "Open"
msgstr "Abrir"

msgid "Open video or image (Ctrl+O)"
msgstr "Abrir vídeo o imagen (Ctrl+O)"

msgid "Export"
msgstr "Exportar"

msgid "Export combined video (Ctrl+E)"
msgstr "Exportar vídeo combinado (Ctrl+E)"

msgid "No Media Loaded"
msgstr "Ningún medio cargado"

msgid "Open a video or image file to begin cutting and arranging clips"
msgstr "Abra un archivo de vídeo o imagen para comenzar a cortar y organizar clips"

msgid "Open Video or Image"
msgstr "Abrir Vídeo o Imagen"

msgid "Add Video or Image as Segment"
msgstr "Añadir Vídeo o Imagen como Segmento"

msgid "Add Video\nor Image"
msgstr "Añadir Vídeo\no Imagen"

msgid "Open Video\nor Image"
msgstr "Abrir Vídeo\no Imagen"

msgid "All Supported Media (Videos & Images)"
msgstr "Todos los Medios Compatibles (Vídeos e Imágenes)"

msgid "Video Files"
msgstr "Archivos de Vídeo"

msgid "Image Files"
msgstr "Archivos de Imagen"

msgid "MP4 Video"
msgstr "Vídeo MP4"

msgid "All Files"
msgstr "Todos los Archivos"

msgid "Audio Files (*.mp3, *.wav, *.aac, *.m4a, *.ogg, *.flac, *.opus)"
msgstr "Archivos de Audio (*.mp3, *.wav, *.aac, *.m4a, *.ogg, *.flac, *.opus)"

msgid "Undo (Ctrl+Z)"
msgstr "Deshacer (Ctrl+Z)"

msgid "Redo (Ctrl+Shift+Z or Ctrl+Y)"
msgstr "Rehacer (Ctrl+Shift+Z o Ctrl+Y)"

msgid "Cut clip (Ctrl+X)"
msgstr "Cortar clip (Ctrl+X)"

msgid "Copy clip (Ctrl+C)"
msgstr "Copiar clip (Ctrl+C)"

msgid "Paste clip (Ctrl+V)"
msgstr "Pegar clip (Ctrl+V)"

msgid "Crop & Rotate (C)"
msgstr "Recortar y Girar (C)"

msgid "Crop & Rotate..."
msgstr "Recortar y Girar..."

msgid "Delete clip (Delete)"
msgstr "Eliminar clip (Supr)"

msgid "Previous segment (Home)"
msgstr "Segmento anterior (Inicio)"

msgid "Step back 1s (Left Arrow)"
msgstr "Retroceder 1s (Flecha Izquierda)"

msgid "Previous frame (,)"
msgstr "Fotograma anterior (,)"

msgid "Play / Pause (Space)"
msgstr "Reproducir / Pausar (Espacio)"

msgid "Next frame (.)"
msgstr "Siguiente fotograma (.)"

msgid "Step forward 1s (Right Arrow)"
msgstr "Avanzar 1s (Flecha Derecha)"

msgid "Next segment (End)"
msgstr "Siguiente segmento (Fin)"

msgid "Move clip left (Alt+Left)"
msgstr "Mover clip a la izquierda (Alt+Izquierda)"

msgid "Move clip right (Alt+Right)"
msgstr "Mover clip a la derecha (Alt+Derecha)"

msgid "Move Clip Left"
msgstr "Mover Clip a la Izquierda"

msgid "Move Clip Right"
msgstr "Mover Clip a la Derecha"

msgid "Split clip at cursor"
msgstr "Dividir clip en el cursor"

msgid "Split at Cursor"
msgstr "Dividir en el Cursor"

msgid "Split"
msgstr "Dividir"

msgid "Cut"
msgstr "Cortar"

msgid "Copy"
msgstr "Copiar"

msgid "Paste"
msgstr "Pegar"

msgid "Delete"
msgstr "Eliminar"

msgid "Generating thumbnails..."
msgstr "Generando miniaturas..."

msgid "Generating thumbnails ({completed}/{total})..."
msgstr "Generando miniaturas ({completed}/{total})..."

msgid "Crop & Rotate"
msgstr "Recortar y Girar"

msgid "Crop & Rotate — {name}"
msgstr "Recortar y Girar — {name}"

msgid "Cancel"
msgstr "Cancelar"

msgid "Apply"
msgstr "Aplicar"

msgid "Rotate 90° Counter-Clockwise"
msgstr "Girar 90° en sentido antihorario"

msgid "Rotate 90° Clockwise"
msgstr "Girar 90° en sentido horario"

msgid "Flip Horizontally"
msgstr "Voltear Horizontalmente"

