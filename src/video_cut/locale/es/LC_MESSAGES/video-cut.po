msgstr "Tiempo en segundos (0.5s – 300.0s)"

msgid "Quick Presets"
msgstr "Ajustes Rápidos"

msgid "Select a standard duration"
msgstr "Seleccione una duración estándar"

msgid "Soundtrack (Optional)"
msgstr "Banda Sonora (Opcional)"

msgid "Attach music or voiceover. If selected, you can slice the exact segment to play."
msgstr "Adjunte música o voz en off. Si se selecciona, puede cortar el segmento exacto para reproducir."

msgid "No Soundtrack Selected"
msgstr "Ninguna Banda Sonora Seleccionada"

msgid "Video will be generated with silent audio"
msgstr "El vídeo se generará con audio silencioso"

msgid "Choose Audio..."
msgstr "Elegir Audio..."

msgid "Change..."
msgstr "Cambiar..."

msgid "Remove soundtrack"
msgstr "Eliminar banda sonora"

msgid "Start Offset:"
msgstr "Desplazamiento Inicial:"

msgid "Preview Audio Slice"
msgstr "Previsualizar Fragmento de Audio"

msgid "Select Soundtrack Audio"
msgstr "Seleccionar Audio de la Banda Sonora"

msgid "Total track duration: {duration}"
msgstr "Duración total de la pista: {duration}"

msgid "Plays {start} → {end} ({duration:.1f}s)"
msgstr "Reproduce {start} → {end} ({duration:.1f}s)"

msgid "Plays {start} → {duration} (padded with silence to {total})"
msgstr "Reproduce {start} → {duration} (rellenado con silencio hasta {total})"

msgid "Export Combined Video"
msgstr "Exportar Vídeo Combinado"

msgid "Exporting Video"
msgstr "Exportando Vídeo"

msgid "Initializing export pipeline..."
msgstr "Inicializando proceso de exportación..."

msgid "Starting..."
msgstr "Iniciando..."

msgid "Preparing streams for {name}..."
msgstr "Preparando flujos para {name}..."

msgid "Rendering video ({percent}%)..."
msgstr "Renderizando vídeo ({percent}%)..."

msgid "Processed: {processed} / {total}"
msgstr "Procesado: {processed} / {total}"

msgid "Export complete: {name}"
msgstr "Exportación completada: {name}"

msgid "Export failed: {error}"
msgstr "Falló la exportación: {error}"

msgid "Unknown error"
msgstr "Error desconocido"

msgid "Failed to convert image: {error}"
msgstr "Error al convertir imagen: {error}"

msgid "Failed to load media: invalid or unsupported file"
msgstr "Error al cargar medios: archivo inválido o no compatible"

msgid "Cannot split too close to clip boundary"
msgstr "No se puede dividir demasiado cerca del límite del clip"

msgid "Cannot delete the only remaining segment"
msgstr "No se puede eliminar el único segmento restante"

msgid "Cannot cut the only remaining segment"
msgstr "No se puede cortar el único segmento restante"

msgid "Crop & Rotate applied to {name}"
msgstr "Recortar y Girar aplicado a {name}"
