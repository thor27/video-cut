msgstr "Restablecer recorte, rotación y volteo"

msgid "Aspect Ratio:"
msgstr "Relación de aspecto:"

msgid "Free"
msgstr "Libre"

msgid "Original"
msgstr "Original"

msgid "Crop: {crop_w} × {crop_h} px ({preset}){rot_str}{flip_str}"
msgstr "Recorte: {crop_w} × {crop_h} px ({preset}){rot_str}{flip_str}"

msgid " • Flip H+V"
msgstr " • Volteo H+V"

msgid " • Flip H"
msgstr " • Volteo H"

msgid " • Flip V"
msgstr " • Volteo V"

msgid "Open Image"
msgstr "Abrir Imagen"

msgid "Import Image as Segment"
msgstr "Importar Imagen como Segmento"

msgid "Import Image Segment"
msgstr "Importar Segmento de Imagen"

msgid "Add Segment"
msgstr "Añadir Segmento"

msgid "Segment Duration"
msgstr "Duración del Segmento"

