#!/bin/bash
set -e

# Resolve APPDIR if not set by runtime
if [ -z "$APPDIR" ]; then
    APPDIR="$(dirname "$(readlink -f "$0")")"
fi

export APPDIR
export PATH="${APPDIR}/usr/bin:${PATH}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Clear foreign Python environment overrides (e.g. from Conda, Pyenv)
unset PYTHONHOME

# Filter out AppImage runtime flags if passed through to AppRun
if [ "$1" = "--appimage-extract-and-run" ]; then
    shift
fi

# Target application entry point
EXEC_TARGET="${APPDIR}/usr/bin/video-cut"
if [ "$#" -gt 0 ] && { [ "$1" = "python3" ] || [ "$1" = "python" ]; }; then
    shift
    EXEC_ARGS=("$@")
elif [ ! -x "$EXEC_TARGET" ]; then
    EXEC_ARGS=("-m" "video_cut" "$@")
else
    EXEC_ARGS=("$EXEC_TARGET" "$@")
fi

# 1. Determine if host system provides a fully capable native GTK4/Libadwaita/GStreamer/Cairo/Pillow stack
HOST_NATIVE_OK=0
HOST_PYTHON=""
for candidate in /usr/bin/python3 /bin/python3 $(command -v python3 2>/dev/null); do
    if [ -x "$candidate" ]; then
        if "$candidate" -c "import gi" 2>/dev/null; then
            HOST_PYTHON="$candidate"
            break
        fi
        if [ -z "$HOST_PYTHON" ]; then
            HOST_PYTHON="$candidate"
        fi
    fi
done

if [ -n "$HOST_PYTHON" ] && [ -z "$FORCE_BUNDLED" ] && [ -z "$FORCE_FALLBACK" ]; then
    if "$HOST_PYTHON" -c "
import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
gi.require_version('Gst', '1.0')
from gi.repository import Adw, Gst
assert hasattr(Adw, 'ToolbarView')
Gst.init(None)
assert Gst.ElementFactory.make('playbin3', None) is not None or Gst.ElementFactory.make('playbin', None) is not None
import cairo
import PIL
" 2>/dev/null; then
        HOST_NATIVE_OK=1
    fi
fi

if [ "$HOST_NATIVE_OK" -eq 1 ]; then
    # Run natively using host environment:
    # Full hardware acceleration (EGL/Vulkan/NGL), native GTK theme, and direct matching with host GStreamer plugins
    export PYTHONPATH="${APPDIR}/usr/lib/python3/dist-packages:${PYTHONPATH:-}"
    exec "$HOST_PYTHON" "${EXEC_ARGS[@]}"
fi

# 2. Fallback mode for older LTS systems (e.g. Ubuntu 22.04) or environments without complete host stack:
# Point to bundled GSettings schemas
if [ -d "${APPDIR}/usr/share/glib-2.0/schemas" ]; then
    export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas:${GSETTINGS_SCHEMA_DIR:-}"
fi

# Isolate GIO module search path to prevent incompatible host GVFS/GIO modules from crashing
if [ -d "${APPDIR}/usr/lib/gio/modules" ]; then
    export GIO_MODULE_DIR="${APPDIR}/usr/lib/gio/modules"
fi

# Point GTK to bundled modules (including media-gstreamer backend)
GTK_PATH=""
for dir in \
    "${APPDIR}/usr/lib/x86_64-linux-gnu/gtk-4.0" \
    "${APPDIR}/usr/lib/gtk-4.0" \
    "${APPDIR}/usr/lib64/gtk-4.0"; do
    if [ -d "$dir" ]; then
        GTK_PATH="${GTK_PATH:+$GTK_PATH:}$dir"
    fi
done
if [ -n "$GTK_PATH" ]; then
    export GTK_PATH
fi

# GObject Introspection typelib search paths: bundled AppDir first
for dir in \
    "${APPDIR}/usr/lib/x86_64-linux-gnu/girepository-1.0" \
    "${APPDIR}/usr/lib/girepository-1.0" \
    "${APPDIR}/usr/lib64/girepository-1.0"; do
    if [ -d "$dir" ]; then
        GI_TYPELIB_PATH="${GI_TYPELIB_PATH:+$GI_TYPELIB_PATH:}$dir"
    fi
done
export GI_TYPELIB_PATH

# GStreamer plugin search paths: isolate to bundled plugins in fallback mode
GST_PLUGINS=""
for dir in \
    "${APPDIR}/usr/lib/x86_64-linux-gnu/gstreamer-1.0" \
    "${APPDIR}/usr/lib/gstreamer-1.0" \
    "${APPDIR}/usr/lib64/gstreamer-1.0"; do
    if [ -d "$dir" ]; then
        GST_PLUGINS="${GST_PLUGINS:+$GST_PLUGINS:}$dir"
    fi
done
if [ -n "$GST_PLUGINS" ]; then
    export GST_PLUGIN_PATH_1_0="$GST_PLUGINS"
    export GST_PLUGIN_SYSTEM_PATH_1_0=""
fi
if [ -x "${APPDIR}/usr/libexec/gstreamer-1.0/gst-plugin-scanner" ]; then
    export GST_PLUGIN_SCANNER="${APPDIR}/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
fi

# Clean up any stale registry cache from earlier runs
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/video-cut/gst-registry"* 2>/dev/null || true

# Isolate GStreamer registry cache per unique AppDir mount to avoid stale temporary paths
APPDIR_HASH="$(printf "%s" "$APPDIR" | md5sum | cut -d' ' -f1)"
export GST_REGISTRY_1_0="/tmp/video-cut-gst-registry-${APPDIR_HASH}.bin"

# Ensure display server backend matches available socket
if [ -n "$WAYLAND_DISPLAY" ]; then
    RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ ! -S "${RUNTIME_DIR}/${WAYLAND_DISPLAY}" ] && [ ! -S "/tmp/${WAYLAND_DISPLAY}" ]; then
        unset WAYLAND_DISPLAY
        unset GDK_BACKEND
    fi
fi
if [ -z "$WAYLAND_DISPLAY" ] && [ -n "$DISPLAY" ]; then
    export GDK_BACKEND=x11
fi

# Prefer hardware-accelerated OpenGL renderer (gl) over CPU software (cairo) or incomplete Vulkan drivers
if [ -z "$GSK_RENDERER" ]; then
    export GSK_RENDERER=gl
fi

# Set up Python for fallback mode: prefer bundled Python 3
PYTHON_BIN=""
if [ -x "${APPDIR}/usr/bin/python3" ]; then
    PYTHON_BIN="${APPDIR}/usr/bin/python3"
    export PYTHONHOME="${APPDIR}/usr"
    BUNDLED_PY_VER="$("$PYTHON_BIN" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "")"
    PYTHONPATH="${APPDIR}/usr/lib/python3/dist-packages"
    if [ -n "$BUNDLED_PY_VER" ] && [ -d "${APPDIR}/usr/lib/python${BUNDLED_PY_VER}/dist-packages" ]; then
        PYTHONPATH="${APPDIR}/usr/lib/python${BUNDLED_PY_VER}/dist-packages:${PYTHONPATH}"
    fi
elif [ -n "$HOST_PYTHON" ]; then
    PYTHON_BIN="$HOST_PYTHON"
    PY_VER="$("$PYTHON_BIN" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "3.10")"
    PYTHONPATH="${APPDIR}/usr/lib/python3/dist-packages"
    if [ -d "${APPDIR}/usr/lib/python${PY_VER}/dist-packages" ]; then
        PYTHONPATH="${APPDIR}/usr/lib/python${PY_VER}/dist-packages:${PYTHONPATH}"
    fi
    for py_dir in /usr/lib/python3* /usr/local/lib/python3*; do
        if [ -d "${py_dir}/dist-packages" ]; then
            PYTHONPATH="${PYTHONPATH}:${py_dir}/dist-packages"
        fi
        if [ -d "${py_dir}/site-packages" ]; then
            PYTHONPATH="${PYTHONPATH}:${py_dir}/site-packages"
        fi
    done
fi

if [ -z "$PYTHON_BIN" ]; then
    echo "Error: No Python interpreter found in AppImage or host." >&2
    exit 1
fi
export PYTHONPATH

# Library search path: bundled glibc & runtime libraries
LIB_PATH="${APPDIR}/glibc:${APPDIR}/usr/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib64:/lib64"

if [ -f "${APPDIR}/glibc/ld-linux-x86-64.so.2" ]; then
    exec "${APPDIR}/glibc/ld-linux-x86-64.so.2" --library-path "$LIB_PATH" "$PYTHON_BIN" "${EXEC_ARGS[@]}"
else
    export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    exec "$PYTHON_BIN" "${EXEC_ARGS[@]}"
fi
